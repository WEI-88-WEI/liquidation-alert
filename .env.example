FWALERT_URL=https://your-fwalert-url.com/call
POLL_INTERVAL_SECONDS=10
COOLDOWN_SECONDS=1800
ENABLE_MONITORING=true
VOLATILITY_WINDOW_SECONDS=60
VOLATILITY_THRESHOLD_PERCENT=1

# 地址开平仓监控。/wallets 页面保存后优先读取 WALLETS_CONFIG_PATH，支持热更新。
# 开单 / 关单电话告警复用上面的 FWALERT_URL；每个地址用 alert_enabled / alert_cooldown_seconds 单独设置。
WALLETS_CONFIG_PATH=wallets_config.json
WALLET_STATE_PATH=wallet_monitor_state.json
WALLETS_CONFIG='{"poll_interval_seconds":15,"wallets":[]}'

# 管理页面保存配置的位置；相对路径以 app.py 所在目录为基准。
COINS_CONFIG_PATH=coins_config.json

# 首次启动配置。管理页面第一次保存后，coins_config.json 将优先于这里的配置。
# 旧配置不写 dex 时默认使用 xyz。
COINS_CONFIG='[
  {
    "dex": "xyz",
    "symbol": "CL",
    "targets": [
      {"price": 98, "direction": "up"}
    ]
  },
  {
    "dex": "io",
    "symbol": "OAI",
    "targets": [
      {"price": 150, "direction": "down"}
    ]
  }
]'
